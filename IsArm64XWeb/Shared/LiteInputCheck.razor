<input type="checkbox"
       checked="@Checked"
        id="@_inputId"
       @oninput="(async (e) => { Checked = ((bool?)e.Value) ?? false; await CheckedChanged.InvokeAsync(Checked); })" />
<label for="@_inputId">@ChildContent</label>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Checked { get; set; }

    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    private readonly string _inputId = $"_{Guid.NewGuid():N}";
}
