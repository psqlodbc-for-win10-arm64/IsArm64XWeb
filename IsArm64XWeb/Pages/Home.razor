@page "/"
@using IsArm64XWeb.Shared
@using LibAmong3.Helpers.Guessr

<PageTitle>IsArm64XWeb</PageTitle>

<p>Please select one or more <code>EXE</code>, <code>DLL</code>, <code>OBJ</code> files to guess binary type. The files are processed inside this WebAssembly:</p>

<details class="mb-3">
    <summary>Possible types</summary>

    <table class="table">
        <thead>
            <tr>
                <th>Output</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _descriptions)
            {
                <tr>
                    <td><code>@item.Key</code></td>
                    <td>@item.Value</td>
                </tr>
            }
        </tbody>
    </table>
</details>

<p>
    <div title="Disable detection of Arm64X binaries.">
        <LiteInputCheck Checked="@_disableArm64XDetection"
                        CheckedChanged="(async (value) => { _disableArm64XDetection = value; await TryToReloadAsync(); })">DisableArm64XDetection</LiteInputCheck>
    </div>

    <div title="Look at CHPE metadata version to help determine the binary form.">
        <LiteInputCheck Checked="@_lookAtCHPEMetadataVersion"
                        CheckedChanged="(async (value) => { _lookAtCHPEMetadataVersion = value; await TryToReloadAsync(); })">LookAtCHPEMetadataVersion</LiteInputCheck>
    </div>

    <div title="Look at DVRT header to help determine the binary form.">
        <LiteInputCheck Checked="@_lookAtDvrtHeader"
                        CheckedChanged="(async (value) => { _lookAtDvrtHeader = value; await TryToReloadAsync(); })">LookAtDvrtHeader</LiteInputCheck>
    </div>
</p>

<p><InputFile OnChange="LoadFiles" multiple /></p>

<pre>@_pre</pre>

@code
{
    private bool _disableArm64XDetection = false;
    private bool _lookAtCHPEMetadataVersion = true;
    private bool _lookAtDvrtHeader = true;
    private IReadOnlyList<IBrowserFile> _providedFiles = Array.Empty<IBrowserFile>();
    private string _pre = "Result here";
    private Dictionary<Arm64XBinaryForm, string> _descriptions = new()
    {
        { Arm64XBinaryForm.X64, "x64 Portable Executable" },
        { Arm64XBinaryForm.Arm64, "Arm64 Portable Executable" },
        { Arm64XBinaryForm.Arm64EC, "Arm64EC Portable Executable" },
        { Arm64XBinaryForm.Arm64X, "Arm64X Portable Executable" },
        { Arm64XBinaryForm.Arm64XPureForwarder, "Arm64X pure forwarder DLL" },
        { Arm64XBinaryForm.X86, "X86 Portable Executable" },
        { Arm64XBinaryForm.Arm64Coff, "Arm64 obj file" },
        { Arm64XBinaryForm.Arm64ECCoff, "Arm64EC obj file" },
        { Arm64XBinaryForm.X64Coff, "x64 obj file" },
        { Arm64XBinaryForm.X86Coff, "x86 obj file" },
        { Arm64XBinaryForm.Arm64XCoffUponX86Coff, "pseudo-ARM64X COFF file" },
        { Arm64XBinaryForm.Arm32, "Arm32 Portable Executable" },
        { Arm64XBinaryForm.Arm32Coff, "Arm32Coff obj file" },
        { Arm64XBinaryForm.AnonymousCoff, "Anonymous obj file" },
    };

    private async Task TryToReloadAsync()
    {
        if (!_providedFiles.Any())
        {
            return;
        }

        var writer = new StringWriter();

        try
        {
            foreach (var file in _providedFiles)
            {
                writer.WriteLine($"File: {file.Name}");
                try
                {
                    using var fileStream = file.OpenReadStream(1024 * 1024 * 500);
                    using var binary = new MemoryStream();
                    await fileStream.CopyToAsync(binary);
                    binary.Position = 0;
                    var guess = new LibAmong3.Helpers.Guessr.GuessArm64XBinaryHelper().Guess(
                        binary.GetBuffer().AsMemory(0, Convert.ToInt32(binary.Length)),
                        new Guess1Options
                        {
                            DisableArm64XDetection = _disableArm64XDetection,
                            LookAtCHPEMetadataVersion = _lookAtCHPEMetadataVersion,
                            LookAtDvrtHeader = _lookAtDvrtHeader,
                        }
                    );
                    writer.WriteLine($"Type: {guess}");
                    writer.WriteLine();
                }
                catch (Exception ex)
                {
                    writer.WriteLine($"Error processing file {file.Name}: {ex}");
                }
            }
        }
        catch (Exception ex)
        {
            writer.WriteLine($"Error reading files: {ex}");
        }

        _pre = writer.ToString();
    }

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        _providedFiles = e.GetMultipleFiles(1000);

        await TryToReloadAsync();
    }

}